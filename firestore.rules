rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function emailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'dalinadjib1990@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collections ---

    // 1. Profiles
    match /profiles/{profileId} {
      allow read: if true;
      allow create: if isValidId(profileId) && isOwner(profileId) && isValidProfile(incoming());
      allow update: if isValidId(profileId) && isOwner(profileId) && isValidProfile(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'title', 'bio', 'cvUrl', 'profileImageUrl', 'stats', 'email'])
      );
      
      function isValidProfile(data) {
        return data.keys().hasAll(['name', 'title', 'bio']) &&
               data.name is string && data.name.size() <= 100 &&
               data.title is string && data.title.size() <= 200 &&
               data.bio is string && data.bio.size() <= 5000 &&
               (!('cvUrl' in data) || data.cvUrl is string) &&
               (!('profileImageUrl' in data) || data.profileImageUrl is string);
      }
    }

    // 2. Articles
    match /articles/{articleId} {
      allow read: if true;
      allow create: if isValidId(articleId) && isAdmin() && isValidArticle(incoming());
      allow update: if isValidId(articleId) && (
        (isAdmin() && isValidArticle(incoming())) ||
        // Allow anyone (guest/visitor or signed-in) to update likes or comments of an article
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'comments']))
      );
      allow delete: if isValidId(articleId) && isAdmin();

      function isValidArticle(data) {
        return data.title is string && data.title.size() <= 200 &&
               data.content is string && data.content.size() <= 100000 &&
               data.excerpt is string && data.excerpt.size() <= 1000 &&
               data.category is string &&
               data.authorId == request.auth.uid &&
               data.createdAt != null;
      }
    }

    // 3. Comments (Alternative match just in case subcollection is used)
    match /articles/{articleId}/comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // 4. Works
    match /works/{workId} {
      allow read: if true;
      allow write: if isValidId(workId) && isAdmin() && isValidWork(incoming());

      function isValidWork(data) {
        return data.title is string && data.title.size() <= 200 &&
               data.description is string && data.description.size() <= 2000 &&
               data.category is string;
      }
    }

    // 5. Messages
    match /messages/{messageId} {
      allow read: if isAdmin();
      allow create: if isValidId(messageId) && isValidMessage(incoming());
      allow update: if isValidId(messageId) && isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['replied', 'replyContent']);
      allow delete: if isValidId(messageId) && isAdmin();

      function isValidMessage(data) {
        return data.senderName is string && data.senderName.size() <= 100 &&
               data.senderEmail is string && data.senderEmail.size() <= 100 &&
               data.subject is string && data.subject.size() <= 200 &&
               data.message is string && data.message.size() <= 5000 &&
               data.createdAt != null;
      }
    }

    // 6. Ratings
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // 7. Live Chat Messages
    match /live_chat/{chatId} {
      allow read, write: if true;
    }

    // 8. Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Stats
    match /stats/global {
      allow read: if true;
      allow write: if true; // Visit tracking
    }
  }
}
