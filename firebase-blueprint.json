{
  "entities": {
    "Profile": {
      "title": "User Profile",
      "description": "Stores user profile and bio information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "bio": { "type": "string" },
        "cvUrl": { "type": "string" },
        "email": { "type": "string" },
        "profileImageUrl": { "type": "string" },
        "stats": {
          "type": "object",
          "properties": {
            "visitors": { "type": "number" },
            "totalLikes": { "type": "number" }
          }
        }
      },
      "required": ["name", "title", "bio"]
    },
    "Article": {
      "title": "Article",
      "description": "A blog post or article",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "excerpt": { "type": "string" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "authorId": { "type": "string" },
        "likes": { "type": "number" }
      },
      "required": ["title", "content", "excerpt", "category", "createdAt", "authorId"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A comment on an article",
      "type": "object",
      "properties": {
        "articleId": { "type": "string" },
        "userName": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "reply": { "type": "string" },
        "replyAt": { "type": "string", "format": "date-time" }
      },
      "required": ["articleId", "userName", "content", "createdAt"]
    },
    "Work": {
      "title": "Work",
      "description": "A portfolio work or project",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "externalUrl": { "type": "string" },
        "rating": { "type": "number" },
        "ratingCount": { "type": "number" },
        "category": { "type": "string" },
        "pdfUrl": { "type": "string" }
      },
      "required": ["title", "description", "imageUrl", "category"]
    },
    "Message": {
      "title": "Message",
      "description": "A contact message from a user",
      "type": "object",
      "properties": {
        "senderName": { "type": "string" },
        "senderEmail": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "replied": { "type": "boolean" },
        "replyContent": { "type": "string" }
      },
      "required": ["senderName", "senderEmail", "subject", "message", "createdAt"]
    }
  },
  "firestore": {
    "profiles": { "schema": "Profile", "description": "User profiles" },
    "articles": { "schema": "Article", "description": "Published articles" },
    "articles/{articleId}/comments": { "schema": "Comment", "description": "Comments on articles" },
    "works": { "schema": "Work", "description": "Portfolio works" },
    "messages": { "schema": "Message", "description": "Contact messages" }
  }
}
